# LifeOS environment placeholders
# Copy to `.env.local` for local development. Never commit real secrets.

# Existing integrations (optional)
REVENUE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Authenticated change-plan writes (default-deny — keep false in production until intentionally enabled)
LIFEOS_WRITE_ENABLED=false
LIFEOS_WRITE_SECRET=
LIFEOS_GITHUB_TOKEN=
LIFEOS_ALLOWED_ORIGIN=

# Voice / audio V1 (browser speech only)
# Set LIFEOS_VOICE_ENABLED=true to show the voice console.
LIFEOS_VOICE_ENABLED=false
LIFEOS_VOICE_BROWSER_FALLBACK=true
# Optional HMAC session secret for /api/lifeos/voice/tools read authorization
LIFEOS_VOICE_SESSION_SECRET=
LIFEOS_VOICE_LOCALE=en
LIFEOS_VOICE_TRANSCRIPTION_LANGUAGE=en
LIFEOS_VOICE_RESPONSE_LANGUAGE=en

# Optional LiveKit credentials (reserved — room tokens are not minted; realtime transport is not advertised as ready)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional agent LLM rewrite (server-side only; never sent to the browser)
LIFEOS_AGENT_LLM_API_KEY=
LIFEOS_AGENT_LLM_BASE_URL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional tool adapters (leave empty unless the integration is actually configured)
CLICKUP_API_TOKEN=
SLACK_BOT_TOKEN=
N8N_WEBHOOK_URL=
VERCEL_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
